# ---------------------------------------------------------------- 系统 / 开发环境
.DS_Store
*.swp
.idea/
.vscode/
node_modules/
.env
.env.local
*.log
npm-debug.log*

# ---------------------------------------------------------------- 打包产物
# electron-builder 的输出目录，见 package.json 的 build.directories.output
dist/
release/
out/

# ---------------------------------------------------------------- 仅本机保留的样例与临时目录
# o-model/ 是约 174MB 的样例模型（.ive 输入 + 各条转换链路的参考 .glb），只在开发机保留；
# 测试 fixture 也从这里恢复（见 CLAUDE.md）。model/ 是修复产物的临时落地目录。
o-model/
model/
refs/
.workbuddy/
.workBuddy/

# ---------------------------------------------------------------- 运行时资产
# Cesium 由 npm run ensure:cesium 下载解包，不入库
vendor/cesium/

# ---------------------------------------------------------------- 构建中间产物
# native/ive2glb 的源码入库，编译输出不入库（vendor/ive2glb/ 是另行裁决的发行件）
native/ive2glb/build/

# ---------------------------------------------------------------- 设计文档与平台台账
# 只入库这些；docs/ 下其余内容由开发流程工具生成
# （coding-standard 里甚至有与本项目无关的 Spring Boot/Vue3/React Native 模板），继续忽略。
# 注意必须写 docs/* 而不是 docs/：一旦整个目录被排除，后面的 ! 否定规则无法把文件捞回来。
# 同理，要放行子目录里的文件，必须先 ! 回复该目录、再排除其内容、最后放行具体文件——
# 只写 !docs/requirements/TASKS.md 是无效的，因为父目录 docs/requirements/ 仍被排除。
docs/*
!docs/001-code-design.md
!docs/002-requirements.md
!docs/cesium-glb-load-issues.md
!docs/requirements/
docs/requirements/*
!docs/requirements/REQUIREMENTS.md
!docs/requirements/TASKS.md
!docs/PROJECT_MEMORY.md
!docs/approvals/
docs/approvals/*
!docs/approvals/APPROVALS.md
!docs/testing/
docs/testing/*
!docs/testing/TEST_PLAN.md
!docs/release/
docs/release/*
!docs/release/RELEASE_CHECKLIST.md
!docs/design/
docs/design/*
!docs/design/ADR.md
.worktrees/

# ---------------------------------------------------------------- 项目开发流程配置（随仓库入库）
# .ai/（agents/skills/workflows/platform-lock.json）、dsh/ 与 scripts/*.mjs 是流程引擎与入口，
# 已随仓库入库，新克隆即可直接跑通 Tenon 流程，不要再把它们当本机配置忽略。
# scripts/ 下 ensure-cesium.js、build-ive2glb.sh 与各 *.mjs 全部入库——
# build-ive2glb.sh 是重建 vendor/ive2glb 助手的唯一途径，不能整目录忽略。
