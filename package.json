{
  "name": "glb-texture-repair-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop tool for repairing Cesium-incompatible GLB textures, materials, and skinned meshes",
  "author": {
    "name": "sunny-zhai",
    "email": "sunny-zhai@users.noreply.github.com"
  },
  "homepage": "https://github.com/sunny-zhai/glb-texture-repair-tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunny-zhai/glb-texture-repair-tool.git"
  },
  "main": "src/main.js",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "ensure:cesium": "node scripts/ensure-cesium.js",
    "build:ive2glb": "bash scripts/build-ive2glb.sh",
    "build:ive2glb:wasm": "bash scripts/build-ive2glb-wasm.sh",
    "dev": "npm run ensure:cesium && electron .",
    "start": "npm run ensure:cesium && electron .",
    "dist:win": "npm run ensure:cesium && electron-builder --win --x64",
    "dist:mac": "npm run ensure:cesium && electron-builder --mac",
    "dist:linux": "npm run ensure:cesium && electron-builder --linux --x64",
    "lint": "for f in src/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.glbtexturerepair.tool",
    "productName": "GLB Texture Repair Tool",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "vendor/ive2glb/wasm/**",
      "node_modules/assimpjs/dist/**"
    ],
    "files": [
      "src/**/*",
      "scripts/**/*",
      "assets/**/*",
      "vendor/cesium/**/*",
      "vendor/ive2glb/wasm/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/app-icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "assets/app-icon.png",
      "maintainer": "sunny-zhai <sunny-zhai@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "assimpjs": "^0.0.10",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
